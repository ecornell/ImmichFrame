<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Generates the Immich client (ImmichFrame.Core.Api.ImmichApi) from the committed spec at build
       time. Refresh the spec with `make immich-spec`. -->
  <PropertyGroup>
    <ImmichApiSpec>$(MSBuildProjectDirectory)/OpenAPIs/immich-openapi-specs.json</ImmichApiSpec>
    <ImmichApiClient>$(BaseIntermediateOutputPath)immich-openapi-specsClient.cs</ImmichApiClient>
  </PropertyGroup>

  <Target Name="GenerateImmichApiClient" BeforeTargets="CoreCompile" Inputs="$(ImmichApiSpec);$(MSBuildProjectFullPath)" Outputs="$(ImmichApiClient)">
    <Exec Command="$(NSwagExe_Net100) openapi2csclient /className:ImmichApi /namespace:ImmichFrame.Core.Api /input:&quot;$(ImmichApiSpec)&quot; /output:&quot;$(ImmichApiClient)&quot; /GenerateOptionalPropertiesAsNullable:true" />
  </Target>

  <Target Name="IncludeImmichApiClient" BeforeTargets="CoreCompile" AfterTargets="GenerateImmichApiClient">
    <ItemGroup>
      <Compile Remove="$(ImmichApiClient)" />
      <Compile Include="$(ImmichApiClient)" />
      <FileWrites Include="$(ImmichApiClient)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="BloomFilter.NetCore" />
    <PackageReference Include="Ical.Net" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NSwag.MSBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenWeatherMap.API" />
    <PackageReference Include="ThumbHash" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ImmichFrame.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
